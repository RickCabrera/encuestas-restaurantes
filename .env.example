# ─── Base de datos ──────────────────────────────────────────────
# Conexión que usa la app (en Supabase/Neon: la URL del pooler).
DATABASE_URL="postgres://postgres:postgres@localhost:5432/encuestas"
# Conexión directa para correr migraciones (opcional; si falta se usa DATABASE_URL).
DIRECT_DATABASE_URL=""
# Conexiones máximas por instancia (en serverless conviene 1–5).
DATABASE_POOL_MAX="5"

# ─── Autenticación ──────────────────────────────────────────────
# Secreto para firmar sesiones. Genera uno con: openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
# Días que dura una sesión del panel.
SESSION_DAYS="7"

# ─── URL pública ────────────────────────────────────────────────
# Se usa para los QR y los enlaces en correos. Sin diagonal final.
APP_URL="http://localhost:3000"

# ─── Versión instalada en PC (docs/INSTALAR-PC.md) ──────────────
# El instalador de Windows pone APP_MODE="local" (http en red local, sin HTTPS).
# En nube se deja sin definir.
# APP_MODE="local"

# ─── Correo (opcional) ──────────────────────────────────────────
# Si no se configura, los correos (recuperación de contraseña y alertas)
# se escriben en el log del servidor en lugar de enviarse.
RESEND_API_KEY=""
EMAIL_FROM="Encuestas <no-reply@tudominio.com>"

# ─── Sentry (opcional) ──────────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ─── Seed (solo para `npm run db:seed`) ─────────────────────────
SEED_ADMIN_EMAIL="admin@demo.com"
SEED_ADMIN_PASSWORD="Admin12345!"
