<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Barras del sistema oscuras (como el encabezado del panel en el celular) en tema claro y oscuro. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/basil</item>
        <item name="android:colorPrimary">@color/basil</item>
        <item name="android:windowBackground">@color/night</item>
        <item name="android:statusBarColor">@color/night</item>
        <item name="android:navigationBarColor">@color/night</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
