<?xml version="1.0" encoding="utf-8"?>
<mx.sitirt.encuestas.tablet.CornerHoldLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/offline"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/paper"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="24dp"
            android:indeterminateTint="@color/basil" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/offline_title"
            android:textColor="@color/ink"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/offline_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:maxWidth="520dp"
            android:textColor="@color/ink_soft"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:maxWidth="520dp"
            android:text="@string/offline_hint"
            android:textColor="@color/ink_faint"
            android:textSize="14sp" />
    </LinearLayout>

</mx.sitirt.encuestas.tablet.CornerHoldLayout>
